{
  "id": "quicklook-replay",
  "viewport": {
    "cols": 160,
    "rows": 45,
    "width": 1280,
    "height": 720
  },
  "capture": {
    "fps": 10,
    "seconds": 18,
    "output": "src/quicklook/frames.json",
    "home": ".capture-home-puretui",
    "repoDefault": "fixture-repo",
    "shellPrompt": "kobe-demo$ "
  },
  "setup": {
    "readyWait": "workspaceReady",
    "seedTasks": [
      {
        "title": "fix flaky retry test",
        "status": "in_progress"
      }
    ]
  },
  "waits": {
    "workspaceReady": {
      "pattern": "KOBE",
      "timeoutMs": 20000
    },
    "newTaskDialog": {
      "pattern": "from branch",
      "timeoutMs": 8000
    },
    "engineReady": {
      "pattern": "edits",
      "timeoutMs": 90000
    }
  },
  "text": {
    "sessionPrompt": "Refactor src/session.ts: collapse the double refresh into one guarded renewal, then commit it.",
    "clientPrompt": "Add a 5s request timeout to createClient in src/client.ts, then commit it."
  },
  "flows": {
    "createTask": {
      "focusPaneBeforeOpen": "leftmost",
      "openKey": "n",
      "dialogWait": "newTaskDialog",
      "dialogSettleMs": 1200,
      "tabCount": 4,
      "tabDelayMs": 500,
      "submitKey": "Enter"
    }
  },
  "beats": [
    {
      "at": 2,
      "action": "flow",
      "flow": "createTask",
      "engine": "claude"
    },
    {
      "at": 2.2,
      "action": "typeTextWhenReady",
      "waitFor": "engineReady",
      "textRef": "sessionPrompt",
      "msPerChar": 15,
      "settleMs": 800,
      "submit": true,
      "submitDelayMs": 400
    },
    {
      "at": 4,
      "action": "sleep",
      "ms": 10000
    },
    {
      "at": 5,
      "action": "flow",
      "flow": "createTask",
      "engine": "claude"
    },
    {
      "at": 5.2,
      "action": "typeTextWhenReady",
      "waitFor": "engineReady",
      "textRef": "clientPrompt",
      "msPerChar": 15,
      "settleMs": 800,
      "submit": true,
      "submitDelayMs": 400
    },
    {
      "at": 7,
      "action": "sleep",
      "ms": 75000
    },
    {
      "at": 9,
      "action": "key",
      "key": "C-q"
    },
    {
      "at": 9.3,
      "action": "key",
      "key": "k"
    },
    {
      "at": 9.6,
      "action": "key",
      "key": "Enter"
    },
    {
      "at": 10,
      "action": "sleep",
      "ms": 4000
    },
    {
      "at": 11,
      "action": "key",
      "key": "C-a"
    },
    {
      "at": 11.2,
      "action": "key",
      "key": "l"
    },
    {
      "at": 11.5,
      "action": "key",
      "key": "]"
    },
    {
      "at": 11.8,
      "action": "sleep",
      "ms": 2500
    },
    {
      "at": 12,
      "action": "key",
      "key": "d"
    },
    {
      "at": 12.2,
      "action": "sleep",
      "ms": 6000
    },
    {
      "at": 12.8,
      "action": "key",
      "key": "q"
    },
    {
      "at": 13.2,
      "action": "key",
      "key": "C-q"
    },
    {
      "at": 13.5,
      "action": "key",
      "key": "j"
    },
    {
      "at": 13.8,
      "action": "key",
      "key": "Enter"
    },
    {
      "at": 14.2,
      "action": "sleep",
      "ms": 4000
    },
    {
      "at": 15,
      "action": "key",
      "key": "C-a"
    },
    {
      "at": 15.2,
      "action": "key",
      "key": "l"
    },
    {
      "at": 15.5,
      "action": "sleep",
      "ms": 2000
    },
    {
      "at": 16,
      "action": "key",
      "key": "d"
    },
    {
      "at": 16.2,
      "action": "sleep",
      "ms": 7000
    }
  ],
  "regions": {
    "chat": {
      "c0": 33,
      "c1": 125,
      "r0": 11,
      "r1": 43
    },
    "dialog": {
      "c0": 30,
      "c1": 130,
      "r0": 6,
      "r1": 38
    },
    "input": {
      "c0": 33,
      "c1": 125,
      "r0": 11,
      "r1": 43
    },
    "review": {
      "c0": 33,
      "c1": 159,
      "r0": 1,
      "r1": 43
    },
    "sidebar": {
      "c0": 0,
      "c1": 45,
      "r0": 1,
      "r1": 43
    },
    "workspace": {
      "c0": 0,
      "c1": 120,
      "r0": 11,
      "r1": 43
    }
  },
  "stages": [
    {
      "name": "boot",
      "from": 0,
      "to": 4.8
    },
    {
      "name": "task-one",
      "from": 4.8,
      "to": 12.4,
      "region": "dialog"
    },
    {
      "name": "prompt-one",
      "from": 12.4,
      "to": 29.7,
      "region": "input"
    },
    {
      "name": "task-two",
      "from": 29.7,
      "to": 36,
      "region": "dialog"
    },
    {
      "name": "parallel",
      "from": 36,
      "to": 110,
      "region": "workspace"
    },
    {
      "name": "review-one",
      "from": 110,
      "to": 119.4,
      "region": "chat"
    },
    {
      "name": "review-two",
      "from": 119.4,
      "to": 122.4,
      "region": "chat"
    },
    {
      "name": "diff",
      "from": 122.4,
      "to": "capture-end",
      "region": "review"
    },
    {
      "name": "wrap",
      "from": "capture-end",
      "to": "end"
    }
  ],
  "camera": {
    "transitionSeconds": 1.2,
    "fit": 0.8,
    "minScale": 1,
    "maxScale": 1.6,
    "tailHoldSeconds": 3,
    "minChangedCells": 10,
    "rowGap": 3,
    "colQuantiles": [
      0.05,
      0.95
    ]
  },
  "theme": {
    "defaultFg": "#FFFFFF",
    "defaultBg": "#141413",
    "ansi16": [
      "#141413",
      "#D47563",
      "#9ACA86",
      "#E8C96B",
      "#CC785C",
      "#9B87F5",
      "#D4967E",
      "#EAE7DF",
      "#3A3835",
      "#E08A76",
      "#B0DCA0",
      "#F2DA8C",
      "#D4967E",
      "#B3A3F8",
      "#E2B39F",
      "#FFFFFF"
    ]
  },
  "delivery": {
    "speedCuts": [
      1,
      4
    ],
    "posterAt": 5
  }
}
