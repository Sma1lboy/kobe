{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@sma1lboy/kobe-plugin-sdk",
  "version": "0.1.1",
  "description": "Typed SDK for writing Rove plugins — env context, event types, daemon socket client, CLI helpers, and a tiny pane kit. Optional sugar over the plain env+CLI+socket contract.",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": "./src/contract.ts"
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sma1lboy/rove.git",
    "directory": "packages/kobe-plugin-sdk"
  },
  "homepage": "https://github.com/Sma1lboy/rove/blob/main/docs/PLUGIN-AUTHORING.md",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "5.8.2",
    "vitest": "2.1.9"
  }
}
